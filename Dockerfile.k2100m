# syntax=docker/dockerfile:1

ARG CUDA_IMAGE=nvcr.io/nvidia/cuda:10.2-devel-ubuntu18.04
ARG CUDA_RUNTIME_IMAGE=nvcr.io/nvidia/cuda:10.2-base-ubuntu18.04
ARG CMAKE_VERSION=3.22.1
ARG GO_VERSION=1.20.14
ARG OLLAMA_REPO=https://github.com/adamciolkowski/ollama.git
ARG OLLAMA_REF=k2100m-cuda10

# Toolchain layers change rarely; keep them before any source checkout.
FROM --platform=linux/amd64 ${CUDA_IMAGE} AS toolchain

ARG CMAKE_VERSION
ARG GO_VERSION

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gcc-8 g++-8 git && rm -rf /var/lib/apt/lists/*

ADD https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz /tmp/cmake.tar.gz
RUN tar -xzf /tmp/cmake.tar.gz -C /usr/local --strip-components=1 && rm /tmp/cmake.tar.gz

ADD https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz /tmp/go.tar.gz
RUN tar -xzf /tmp/go.tar.gz -C /usr/local && rm /tmp/go.tar.gz

ENV PATH=/usr/local/go/bin:${PATH}
ENV CC=gcc-8
ENV CXX=g++-8
ENV CUDAHOSTCXX=g++-8
ENV OLLAMA_CUDA_10_COMPAT=1
ENV CMAKE_CUDA_ARCHITECTURES=30
ENV CGO_ENABLED=1

# Kepler branch from this fork (includes llama.cpp patches and gpu NVML paths).
FROM toolchain AS ollama-src

ARG OLLAMA_REPO
ARG OLLAMA_REF

WORKDIR /src
RUN git clone --branch "${OLLAMA_REF}" --depth 1 "${OLLAMA_REPO}" . && git submodule update --init llm/llama.cpp

FROM ollama-src AS llama-native

WORKDIR /src/llm/generate
RUN bash gen_linux.sh

FROM llama-native AS build

WORKDIR /src
RUN mkdir -p /out && go build -a \
    -ldflags "-X github.com/jmorganca/ollama/version.Version=0.1.18-k2100m.3" \
    -o /out/ollama .

FROM scratch AS artifact
COPY --from=build /out/ollama /ollama

# Same NVIDIA runtime family as the nvidia-smi preflight check (plain ubuntu misses driver libs on WSL).
FROM --platform=linux/amd64 ${CUDA_RUNTIME_IMAGE} AS runtime

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/ollama /bin/ollama

ENV OLLAMA_HOST=0.0.0.0
ENV OLLAMA_GPU=cuda
ENV OLLAMA_GPU_MEMORY=1879048192
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

VOLUME ["/root/.ollama"]
EXPOSE 11434

ENTRYPOINT ["/bin/ollama"]
CMD ["serve"]
